# Copy to `.env` and uncomment only what you need:
#
#     cp .env.example .env
#
# Fill PROJECT_ROOT after copying this file. Everything else active below is
# derived from it or is a portable default. `run_eval.py` and every dataset
# script read this file automatically; variables already exported in your shell
# take precedence.

# ---------------------------------------------------------------------------
# Repository location — required. Use an absolute path.
# ---------------------------------------------------------------------------
export PROJECT_ROOT=/absolute/path/to/multiturn-info-seek
export DATA_DIR="${PROJECT_ROOT}/data"
export RESULTS_DIR="${PROJECT_ROOT}/logs"

# ---------------------------------------------------------------------------
# Local (open-weight) models — the only thing the suite needs is the port your
# OpenAI-compatible server is listening on. Every dataset, 20-Questions
# included, reads this one variable.
# ---------------------------------------------------------------------------
export VLLM_PORT=8011

# Optional: a non-local / non-default endpoint. VLLM_BASE_URL overrides
# VLLM_PORT outright. If a remote endpoint requires authentication, use
# --model-config and its api_key_env field (see SETUP.md).
# export VLLM_BASE_URL=http://127.0.0.1:8011/v1

# ---------------------------------------------------------------------------
# Hosted model API keys — uncomment only the ones you'll actually use.
# ---------------------------------------------------------------------------

# GPT models. We used Azure OpenAI; the standard OpenAI API also works.
# export AZURE_OPENAI_API_KEY=
# export AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
# export AZURE_OPENAI_API_VERSION=2024-10-21
#
# ...or plain OpenAI (used when AZURE_OPENAI_API_KEY is unset). OPENAI_BASE_URL
# also points at an OpenAI-compatible gateway (OpenRouter, Ollama, SGLang, ...).
# export OPENAI_API_KEY=
# export OPENAI_BASE_URL=https://openrouter.ai/api/v1

# Gemini.
# export GOOGLE_API_KEY=
#
# ...or Gemini through Vertex AI instead of an API key.
# export GOOGLE_GENAI_USE_VERTEXAI=True
# export GOOGLE_CLOUD_PROJECT=your-project
# export GOOGLE_CLOUD_LOCATION=global

# ---------------------------------------------------------------------------
# GeneReg-MT assets — `bash setup.sh` creates these and prints the two paths.
# The defaults below match what setup.sh writes, so you usually need do nothing.
# ---------------------------------------------------------------------------
export CACHE_DIR="${PROJECT_ROOT}/.grn_cache"
export MODELS_DIR="${PROJECT_ROOT}/.kadelka/update_rules_122_models_Kadelka_SciAdv"

# ---------------------------------------------------------------------------
# Local model weights cache (only if you serve open-weight models yourself and
# want to reuse an existing HuggingFace cache).
# ---------------------------------------------------------------------------
# export HF_HUB_CACHE=/path/to/hf/hub
# export HF_HUB_OFFLINE=1        # only if the weights are already downloaded

# ---------------------------------------------------------------------------
# ClinGuide-MT (data not released; only needed if you run its pipeline).
# ---------------------------------------------------------------------------
# export ORACLE_MODEL=gpt-5-mini
# export JSON_DIR=/path/to/clinguide/data

# ---------------------------------------------------------------------------
# Data regeneration only (not needed to run evaluations).
#   Logic-Q-MT raw rulesets: https://storage.googleapis.com/questbench/questbench_data.tar.gz
# ---------------------------------------------------------------------------
# export LOGIC_Q_RP_DIR=/path/to/questbench_data/Logic-Q/RP/RP
# export LOGIC_Q_INTERMEDIATE_DIR=${PROJECT_ROOT}/logs/logic_q_intermediates
